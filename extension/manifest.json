{
  "manifest_version": 3,
  "name": "회의 미터기",
  "version": "0.0.0",
  "description": "회의에 드는 비용을 택시 미터기처럼 실시간으로 보여줍니다.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "회의 미터기 열기",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "clipboardWrite"]
}
